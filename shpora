6. ТИПИЧНАЯ СТРУКТУРА ДЛЯ CLIPFORGE
--------------------------------------------------------------------------------

class ClipModel(QObject):
    item_added = Signal(str)
    
    def __init__(self):
        self.clipboard = QGuiApplication.clipboard()
        self._ignore_next = False
        self.clipboard.dataChanged.connect(self.on_clipboard_changed)
    
    def on_clipboard_changed(self):
        if self._ignore_next:
            self._ignore_next = False
            return
        
        mime = self.clipboard.mimeData()
        if mime.hasText():
            text = mime.text().strip()
            if text:
                self.item_added.emit(text)
    
    def copy_to_clipboard(self, text):
        self._ignore_next = True
        self.clipboard.setText(text)


class ClipView(QMainWindow):
    def add_item(self, text):
        item = QListWidgetItem()
        preview = text[:100] + "..." if len(text) > 100 else text
        item.setText(preview)
        item.setData(Qt.UserRole, text)
        item.setToolTip(text)
        self.history_list.addItem(item)


class ClipController(QObject):
    def __init__(self, model, view):
        self.model = model
        self.view = view
        self.model.item_added.connect(self.view.add_item)
        self.view.history_list.itemClicked.connect(self.copy_item)
    
    def copy_item(self, item):
        text = item.data(Qt.UserRole)
        self.model.copy_to_clipboard(text)


