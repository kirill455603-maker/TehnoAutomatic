         <property name="styleSheet">
          <string notr="true">/* Сам виджет — прозрачный фон */
* {
 background: rgba(255, 255, 255, 0);
}
QTableWidget {
    background: transparent;
    border: none;
    color: #ffffff;
    gridline-color: rgba(255, 255, 255, 0.15);
    selection-background-color: rgba(255, 255, 255, 0.25);
    selection-color: #ffffff;
}

/* Ячейки — без фона, белый текст */
QTableWidget::item {
    background: transparent;
    color: #ffffff;
    padding: 4px 6px;
    border: none;
	border-left: 1px solid rgba(255, 255, 255, 0.15);
	border-bottom: 1px solid rgba(255, 255, 255, 0.15);
	border-right: 1px solid rgba(255, 255, 255, 0.15);

}






/* Заголовки — ЕДИНСТВЕННОЕ место с фоном */
QHeaderView::section {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(12, 123, 147, 255), stop:1 rgba(0, 168, 204, 255));
    color: #ffffff;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: bold;
}



/* Угловая кнопка (пересечение заголовков) */
QTableCornerButton::section {
    background-color:  qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(12, 123, 147, 255), stop:1 rgba(0, 168, 204, 255));
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

/* Скроллбары — минимально, чтобы не мешали */
QTableWidget QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QTableWidget QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    min-height: 20px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.5);
}

QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical,
QTableWidget QScrollBar::add-page:vertical,
QTableWidget QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QTableWidget QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QTableWidget QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    min-width: 20px;
}

QTableWidget QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.5);
}

QTableWidget QScrollBar::add-line:horizontal,
QTableWidget QScrollBar::sub-line:horizontal,
QTableWidget QScrollBar::add-page:horizontal,
QTableWidget QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0px;
}
QPushButton {
	image: url(:/icons/trash.png);
	padding: 10;
	width: 30;
	height: 30;
}
QPushButton:hover {
	image: url(:/icons/trash_grey.png);
	cursor: pointer;
}</string>
