          <property name="styleSheet">
           <string notr="true">/* === Сама таблица === */
QTableWidget {
	border: none;
    gridline-color: rgba(0, 0, 0, 0);             /* Цвет линий сетки */
    selection-background-color: #0078d7; /* Цвет фона выделенной ячейки */
    selection-color: rgb(42, 82, 127);            /* Цвет текста выделенной ячейки */                  /* Убираем рамку фокуса */
}

/* === Заголовки столбцов и строк === */
QHeaderView::section {
    background-color: rgba(74, 74, 74, 0);
    color: rgb(255, 255, 255);
    padding: 6px;
    border: none;   /* Разделитель между заголовками */
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:last {
	border: none;
}

/* Угловая кнопка (пересечение заголовков строк и столбцов) */
QTableCornerButton::section {
    background-color: rgba(74, 74, 74, 0);
    border: none;
}

/* === Ячейки таблицы === */
QTableWidget::item {
    padding: 5px;
	border-bottom: 1px solid white;
    color: rgb(255, 255, 255);
}

/* Состояние при наведении мыши */
QTableWidget::item:hover {
    color: rgb(202, 202, 202);
}

/* Состояние выделенной ячейки (переопределяем hover, если она выделена) */
QTableWidget::item:selected {
    background-color: qlineargradient(spread:pad, x1:0, y1:1, x2:1, y2:0, stop:0 rgba(39, 72, 109, 129), stop:1 rgba(21, 41, 81, 129));
    color: rgb(152, 152, 152);
}

/* === Полосы прокрутки === */
QScrollBar:vertical {
    background: #f4f6f8;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; /* Скрываем стрелки прокрутки */
}

QScrollBar:horizontal {
    background: #f4f6f8;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: #c0c0c0;
    min-width: 20px;
    border-radius: 5px;
}</string>
