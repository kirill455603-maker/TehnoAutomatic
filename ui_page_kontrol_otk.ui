       <pointsize>10</pointsize>
      </font>
     </property>
     <property name="styleSheet">
      <string notr="true">/* Сам виджет — прозрачный фон */
QTableWidget {
    background: transparent;
    border: none;
    color: #ffffff;
    gridline-color: rgba(255, 255, 255, 0.15);
    selection-background-color: rgba(255, 255, 255, 0.25);
    selection-color: #ffffff;
}

/* Ячейки — без фона, белый текст */
QTableWidget::item {
    background: transparent;
    color: #ffffff;
    padding: 4px 6px;
    border: none;
	border-left: 1px solid rgba(255, 255, 255, 0.15);
	border-bottom: 1px solid rgba(255, 255, 255, 0.15)

}

QTableWidget::item:hover {
    background: rgba(255, 255, 255, 0.08);
}

QTableWidget::item:selected {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* Заголовки — ЕДИНСТВЕННОЕ место с фоном */
QHeaderView::section {
    background-color: rgb(21, 69, 140);
    color: #ffffff;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #3a3a3a;
}

/* Угловая кнопка (пересечение заголовков) */
QTableCornerButton::section {
    background-color:  rgb(21, 69, 140);
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
}

/* Скроллбары — минимально, чтобы не мешали */
QTableWidget QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QTableWidget QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    min-height: 20px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.5);
}

QTableWidget QScrollBar::add-line:vertical,
QTableWidget QScrollBar::sub-line:vertical,
QTableWidget QScrollBar::add-page:vertical,
QTableWidget QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QTableWidget QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QTableWidget QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    min-width: 20px;
}

QTableWidget QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.5);
}

QTableWidget QScrollBar::add-line:horizontal,
QTableWidget QScrollBar::sub-line:horizontal,
QTableWidget QScrollBar::add-page:horizontal,
QTableWidget QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0px;
}
QPushButton {
	border: 1px solid white;
	margin-top: 25px;
	margin-bottom: 25px;
	margin-left: 20px;
	margin-right: 20px;
	border-radius: 8px;
}
QPushButton:hover {
	border: 2px solid white;
	background: rgb(15, 65, 159)
}</string>
     </property>
     <property name="verticalScrollBarPolicy">
